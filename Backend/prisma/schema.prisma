// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trustedContacts TrustedContact[]
  places Place[]
  journeys Journey[]
  notifications Notification[]
}



model TrustedContact {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  phone        String
  email        String?
  relationship String?
  priority     Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model Place {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  address   String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  originJourneys      Journey[] @relation("JourneyOrigin")
  destinationJourneys Journey[] @relation("JourneyDestination")

  @@index([userId])
}

model Journey {
  id                Int       @id @default(autoincrement())
  userId            Int
  originId          Int
  destinationId     Int

  plannedDeparture  DateTime
  expectedDuration  Int
  expectedArrival   DateTime?

  actualDeparture   DateTime?
  actualArrival     DateTime?

  status            JourneyStatus @default(PLANNED)

  departureConfirmations Int @default(0)
  arrivalConfirmations Int @default(0)

  batteryPercentage Int?
  batteryStatus     String?

  lastHeartbeatAt DateTime?
  deviceStatus    String?

  lastLocationAt DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  origin            Place @relation("JourneyOrigin", fields: [originId], references: [id])
  destination       Place @relation("JourneyDestination", fields: [destinationId], references: [id])

  @@index([userId])
  @@index([originId])
  @@index([destinationId])

  locations JourneyLocation[]
  notifications Notification[]
}

enum JourneyStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
  MISSED
}



model JourneyLocation {
  id        Int      @id @default(autoincrement())

  journeyId Int
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float

  accuracy  Float?
  speed     Float?

  recordedAt DateTime

  createdAt DateTime @default(now())

  @@index([journeyId])
  @@index([recordedAt])
}


model Notification {
    id        Int      @id @default(autoincrement())

    userId    Int
    journeyId Int?

    type      String
    channel   String
    status    String   @default("PENDING")

    message   String

    createdAt DateTime @default(now())
    sentAt    DateTime?

    user      User      @relation(fields: [userId], references: [id])
    journey   Journey?  @relation(fields: [journeyId], references: [id])

    @@index([userId])
    @@index([journeyId])
}